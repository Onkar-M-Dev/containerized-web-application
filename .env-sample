# Flask
SECRET_KEY=replace_with_a_random_secret

# PostgreSQL - Docker Compose
POSTGRES_PASSWORD=replace_with_a_strong_database_password
SQLALCHEMY_DATABASE_URI=postgresql://postgres:replace_with_a_strong_database_password@db:5432/flaskblog

# Mailjet SMTP
MAIL_SERVER=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_mailjet_api_key
EMAIL_PASS=your_mailjet_secret_key
MAIL_DEFAULT_SENDER=your_verified_sender@example.com